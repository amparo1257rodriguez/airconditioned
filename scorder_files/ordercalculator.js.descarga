							}
						}
						elm.events[evt].push(func);
						elm["on" + evt] = dLite.handleEvent;
						
						if (!func.attachedElements) {
							func.attachedElements = {};
						}
						func.attachedElements[evt + elm.uniqueHandlerId] = true;
					}
				};
			}
			return this.addEvent(elm, evt, func);

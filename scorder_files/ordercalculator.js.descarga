/*

	Start most of the calculator code 
	
*/
	
	var f, dom = {}, shipzone = 'usa', external = {}, parthash = {};
	
	
	
	
	/* helper functions  */
	
	// from : http://phpjs.org/functions/number_format:481
	function number_format(number, decimals, dec_point, thousands_sep) {
	    // Formats a number with grouped thousands  
	    // 
	    // version: 1009.2513
	    // discuss at: http://phpjs.org/functions/number_format
		// additional comments removed to save a tiny bit of bandwidth (@johnbeales)
	
	    number = (number+'').replace(',', '').replace(' ', '');
	    var n = !isFinite(+number) ? 0 : +number, 
	        prec = !isFinite(+decimals) ? 0 : Math.abs(decimals),
	        sep = (typeof thousands_sep === 'undefined') ? ',' : thousands_sep,
	        dec = (typeof dec_point === 'undefined') ? '.' : dec_point,
	        s = '',
	        toFixedFix = function (n, prec) {
	            var k = Math.pow(10, prec);
	            return '' + Math.round(n * k) / k;
	        };
	    // Fix for IE parseFloat(0.55).toFixed(0) = 0;
	    s = (prec ? toFixedFix(n, prec) : '' + Math.round(n)).split('.');
	    if (s[0].length > 3) {
	        s[0] = s[0].replace(/\B(?=(?:\d{3})+(?!\d))/g, sep);
	    }
	    if ((s[1] || '').length < prec) {
	        s[1] = s[1] || '';
	        s[1] += new Array(prec - s[1].length + 1).join('0');
	    }
	    return s.join(dec);
	}
	
	
	

	
	// make a number look like a dollar value
	function dollar(val) {
		return number_format(val,2);
	}
	
	
	function inArray(val, array) {
	
		for(var i=0,len=array.length;i<len;i++) {
			if(array[i] == val) {
				return true;
			}
		}
		return false;
	}
	
	
	/**
	Takes a URL with no protocol on it and prepends the appropriate http:// or https:// for the page.
	*/
	function protocol_url(url) {
	
		return  (("https:" == document.location.protocol) ? "https://" : "http://") + url;
	
	
	}
	
	function isNumber(n) {
	  return !isNaN(parseFloat(n)) && isFinite(n);
	}
	
	
	function collectionToArray(collection)  
		{  
		    var ary = [];  
		    for(var i=0, len = collection.length; i < len; i++)  
		    {  
		        ary.push(collection[i]);  
		    }  
		    return ary;  
		}  
	
	/* done helper functions  */
	
	
	function geocode(address) {
		var script, url, mapkey = 'ArRPmDLJaaPlX2oYwLxViZv-KGxNbX6_woi6vsw1up98tascQaAVbw4NL4jupsBS';
	
		url = 'dev.virtualearth.net/REST/v1/Locations?query=' + encodeURIComponent(address) + '&key=' + mapkey;
		url += '&jsonp=' + encodeURIComponent('swampy_handlegeocoded');

	
		script = document.createElement("script");
	  	script.type = "text/javascript";
	  	script.src = protocol_url(url);
	  	document.body.appendChild(script);	
	
	
	
	
	}
	
	
		
	
	external.handlegeocoded = function(results) {
	
//		console.log(results);
		
		var state, country, result = false;
		
		result = results.resourceSets[0].resources[0].address;
		
		
		if(results.resourceSets) {
			if(results.resourceSets.length > 0) {
				if(results.resourceSets[0].resources) {
					if(results.resourceSets[0].resources.length > 0) {
						if(results.resourceSets[0].resources[0].address && results.resourceSets[0].resources[0].confidence == 'High') {
							result = results.resourceSets[0].resources[0].address;
						}
					}
				}
			}
		}
		
		
		if(result) {
			country = result.countryRegion;
			state = result.adminDistrict;
		
       		if(country == 'United States') {
       			if(state == 'AZ') {
       				shipzone = 'arizona';
       			} else if(state == 'AK' || state == 'HI') {
       				shipzone = 'canada';
       			} else {
       				shipzone = 'usa';
       			}
       		} else if(country == 'Canada' || country == 'Puerto Rico') {
       			shipzone = 'canada';
       		} else if(country == 'Australia') {
       			shipzone = 'australia';
       		} else {
       			shipzone = 'world';
       		}  	
       	}
       	
       	
       	update(null);
    }
	
	
	
	function updateAddressData(e) {
	
		var adrstr = '', execute = true;

		if(dom.address.value.length == 0) {
			execute = false;
		} else {
			adrstr += dom.address.value;
		}
		
		if(dom.city.value.length == 0) {
			execute = false;
		} else {
			adrstr += ', ' + dom.city.value;
		}if(dom.state.value.length > 0) {
  		adrstr += ', ' + dom.state.value;
		}

		if(dom.zip.value.length > 0) {
  		adrstr += ', ' + dom.zip.value;
		}


		
		if(execute) {
    		geocode(adrstr);
    	}
  	}

	
	
	
	
	
	
	function update(e) {
		var current, total = 0, i, el, prod, hasPart = false, hasWarned = false;
		
		// for the main product, get the subtotal
		if(dom.qty.value > 0 && dom.model.value != 'none') {
			current = prods[dom.model.value];
			total = current.price[shipzone] * dom.qty.value;
		}
		dom.itemprice.value = dollar(total);
		
		
		for(i in parthash) {
			el = elm(i);
			
			if(isNumber(el.value) && el.value > 0) {
				prod = prods[parthash[i]];
				total = total + (prod.price[shipzone] * el.value);
				
				if(!inArray(dom.model.value, prod.goeswith) && hasWarned == false && (typeof el.haswarned == 'undefined' || el.haswarned === null || el.haswarned == 0)) {
					alert('Caution: This accessory is not compatible with the cooler that you have ordered.  Check to make sure you want to order it.');
					hasWarned = true;
					el.haswarned = 1;
				}
				
				hasPart = true;
				
				
			} else {
				el.value = 0;
				el.haswarned = 0;
			}
			
		}
		
		// add shipping for accessories when not ordering a cooler
		if(hasPart) {
			if(!isNumber(dom.qty.value) || dom.qty.value == 0 || dom.model.value == 'none') {
				total += 12
			}
		}
		
		
		
		
		// print the grand total
		dom.total.value	= dollar(total);
	}
	
	
	
	
	function initCalc() {
	
	
		var ipts, sels;
	
		if(document.getElementsByTagName('form').length > 0) {
			
			f = document.getElementsByTagName('form')[0];
			// get all input elements
			ipts = f.getElementsByTagName('input');
			// add any select elements to the array
			
			sels = f.getElementsByTagName('select');
		
			
			// convert the two nodelists into arrays so they can be concatted
			ipts = collectionToArray(ipts);
			sels = collectionToArray(sels);
			
			
			ipts = ipts.concat(sels);
			// set the ID on all inputs & selects to be the same as the name
			for(var i=0,len=ipts.length;i<len;i++){
				ipts[i].setAttribute('id',ipts[i].getAttribute('name'));
			}
			
			
			dom.model = elm('Model');
			dom.qty = elm('Qty');
			dom.itemprice = elm('Product$');
			dom.total = elm('amtauthrizd');
			
			dom.address = elm('Address');
			dom.city = elm('City');
			dom.state = elm('State');
			dom.zip = elm('Zip');
			dom.country = elm('country');
			
			
			for(var i=0 in prods) {
				if(prods[i].fieldname) {
					parthash[prods[i].fieldname] = i;
					addEvent(elm(prods[i].fieldname), 'change', update);
				}
			}
			
			// add some eventhandlers
			addEvent(dom.model,'change',update);
			addEvent(dom.qty,'change',update);
			
			
			// set some event handlers
			addEvent(dom.address, 'change', updateAddressData);
			addEvent(dom.city, 'change', updateAddressData);
			addEvent(dom.state, 'change', updateAddressData);
			addEvent(dom.zip, 'change', updateAddressData);
			addEvent(dom.country, 'change', updateAddressData);
			
			updateAddressData(null);

			
			
			update(null);
			
			
			window.swampy = external;
			window.swampy_handlegeocoded = external.handlegeocoded;
			
			loadMapScript();
		
		
		}
	
	
	
	}
	
	
	


	DOMReady(initCalc);








})();

}

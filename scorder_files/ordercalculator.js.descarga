(function() {

	var prods = {};
	
	function addProduct(prod) {
		if(prod.id && prod.price) {
			if(prod.price.usa && prod.price.canada && prod.price.arizona && prod.price.australia && prod.price.world) {
				prod.id = prod.id.toLowerCase();
				prods[prod.id] = prod;
			}
		}
	}
	
	
